{
  "default": "gpt",
  "providers": {
    "gpt": {
      "type": "openai_compatible",
      "base_url": "https://api.openai.com/v1",
      "model": "gpt-5.6-luna",
      "api_key_env": "OPENAI_API_KEY",
      "max_tokens_field": "max_completion_tokens",
      "params": {"timeout": 300, "reasoning_effort": "none"}
    },
    "gpt_batch": {
      "type": "openai_compatible",
      "base_url": "https://api.openai.com/v1",
      "model": "gpt-5.6-luna",
      "api_key_env": "OPENAI_API_KEY",
      "max_tokens_field": "max_completion_tokens",
      "native_batch": true,
      "params": {"timeout": 300, "reasoning_effort": "none"}
    },
    "deepseek": {
      "type": "litellm",
      "model": "deepseek/deepseek-v4-flash",
      "api_key_env": "DEEPSEEK_API_KEY",
      "params": {"timeout": 120},
      "enabled": false
    },
    "safechain": {
      "adapter": "safechain",
      "requires": ["SAFECHAIN_API_KEY"],
      "enabled": false
    }
  }
}
